#!/bin/sh

# pre-commit: 특정 확장자는 무조건 DVC, 조건부 확장자는 100MB 초과 시 DVC
# 이미 DVC로 추적 중이면 건너뜀, dvc add 실패 시 git rm 및 gitignore 조작도 하지 않음

LIMIT=104857600  # 100MB
found=false

# 1) 스테이징된 추가/수정 파일만 검사
git diff --cached --name-only -z --diff-filter=AM | \
while IFS= read -r -d '' file; do
    if [ -f "$file" ]; then
        ext="${file##*.}"
        size=$(wc -c <"$file")
        process=false

        # 확장자 규칙 적용
        case "$ext" in
            fbx|anim|wav|mp4|psd|exr|hdr|tga)  # 무조건 DVC
                process=true ;;
            png|jpg|obj|blend|prefab)          # 조건부: 100MB 초과
                [ $size -gt $LIMIT ] && process=true ;;
        esac

        if [ "$process" = true ]; then
            echo "⚠️ DVC 대상 파일 감지: $file (size: $size bytes)"

            # 이미 DVC에서 추적 중인지 확인 (.dvc 메타 존재)
            if [ -f "$file.dvc" ]; then
                echo "ℹ️ Already tracked by DVC (.dvc exists): $file → skip"
                continue
            fi

            # dvc add 실행
            if dvc add "$file"; then
                echo "✅ dvc add succeeded for $file"

                # Git 추적에서 제거 (Git에 올라가 있을 때만)
                if git ls-files --cached --error-unmatch "$file" >/dev/null 2>&1; then
                    git rm --cached "$file"
                fi

                # .dvc 파일 자동 add
                [ -f "$file.dvc" ] && git add "$file.dvc"

                # 해당 디렉토리의 .gitignore 자동 add
                dir=$(dirname "$file")
                [ -f "$dir/.gitignore" ] && git add "$dir/.gitignore"

                found=true
            else
                echo "❌ dvc add failed for $file, skipping..."
            fi
        fi
    fi
done

# 커밋 중단 처리
if [ "$found" = true ]; then
    echo "❌ Commit aborted. Some files were moved to DVC."
    echo "   Please commit again (.dvc + .gitignore now included)."
    exit 1
fi

exit 0
